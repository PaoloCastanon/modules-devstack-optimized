# Copy outside Git and point to private files with mode 0600 or stricter.
PLACEMENT_GO_LISTEN_ADDR=127.0.0.1:8779
PLACEMENT_GO_PUBLIC_BASE_URL=http://127.0.0.1:8779
PLACEMENT_GO_DATABASE_DSN_FILE=/absolute/private/path/placement-go-app.dsn
PLACEMENT_GO_KEYSTONE_AUTH_URL=https://identity.example.invalid/v3
PLACEMENT_GO_KEYSTONE_CREDENTIAL_FILE=/absolute/private/path/placement-go-service.json
PLACEMENT_GO_REQUEST_TIMEOUT=15s
PLACEMENT_GO_DEPENDENCY_TIMEOUT=5s
PLACEMENT_GO_MAX_BODY_BYTES=1048576
