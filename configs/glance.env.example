# Copy to a private file outside Git. This example contains no credentials.
# Glance Go reads the ORIGINAL Glance's glance-api.conf: database (account and
# catalog), store directory, Keystone service user and notifications come from
# there and must not be repeated here.
GLANCE_GO_CONFIG_FILE=/etc/glance/glance-api.conf
GLANCE_GO_LISTEN_ADDR=127.0.0.1:9293
# HTTP(S) base; optional path prefix, no query/fragment or percent escapes.
GLANCE_GO_PUBLIC_BASE_URL=http://127.0.0.1:9293
GLANCE_GO_REQUEST_TIMEOUT=15s
GLANCE_GO_DEPENDENCY_TIMEOUT=5s
GLANCE_GO_MAX_BODY_BYTES=1048576
GLANCE_GO_BINARY_ENABLED=true
# Existing private root (0700) for the store lock and scope marker, explicitly
# initialized with glance store-init. Image files go to filesystem_store_datadir.
GLANCE_GO_STORE_ROOT=/absolute/private/path/glance-go-store
# Obtain the deterministic UUID with glance store-scope.
GLANCE_GO_STORE_SCOPE=REPLACE_WITH_VERIFIED_SCOPE
GLANCE_GO_MAX_UPLOAD_BYTES=1073741824
GLANCE_GO_MAX_CONCURRENT_TRANSFERS=16
# Downloads sending bytes at once; the rest wait. Empty = GOMAXPROCS (min. 2), at most MAX_CONCURRENT_TRANSFERS.
# GLANCE_GO_MAX_DOWNLOAD_STREAMS=2
GLANCE_GO_UPLOAD_TIMEOUT=10m
GLANCE_GO_DOWNLOAD_TIMEOUT=10m
GLANCE_GO_RESOLUTION_TIMEOUT=10s
GLANCE_GO_RECOVERY_TIMEOUT=5m
GLANCE_GO_SHUTDOWN_TIMEOUT=30s
