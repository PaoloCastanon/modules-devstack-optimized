# Copy to a private file outside Git. These paths must refer to existing files
# with mode 0600 or stricter. This example contains no working credentials.
GLANCE_GO_LISTEN_ADDR=127.0.0.1:9293
# HTTP(S) base; optional path prefix, no query/fragment or percent escapes.
GLANCE_GO_PUBLIC_BASE_URL=http://127.0.0.1:9293
# Remote MySQL requires tls=true; no fallback. Use direct grants, no roles, autocommit=1.
GLANCE_GO_DATABASE_DSN_FILE=/absolute/private/path/glance-go-app.dsn
GLANCE_GO_KEYSTONE_AUTH_URL=https://identity.example.invalid/v3
GLANCE_GO_KEYSTONE_CREDENTIAL_FILE=/absolute/private/path/glance-go-service.json
GLANCE_GO_REQUEST_TIMEOUT=15s
GLANCE_GO_DEPENDENCY_TIMEOUT=5s
GLANCE_GO_MAX_BODY_BYTES=1048576
